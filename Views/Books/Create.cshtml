@model Book_manager.Models.Book

@{
    ViewData["Title"] = "Add Book";
}

<div class="container mt-4">
    <h2 class="mb-4">📚 Add New Book</h2>
    <div class="card p-4" style="max-width: 600px;">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-bold"></label>
                <input asp-for="Title" class="form-control" placeholder="Book title" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Author" class="form-label fw-bold"></label>
                <input asp-for="Author" class="form-control" placeholder="Author name" />
                <span asp-validation-for="Author" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col">
                    <label asp-for="Genre" class="form-label fw-bold"></label>
                    <input asp-for="Genre" class="form-control" placeholder="Genre" />
                    <span asp-validation-for="Genre" class="text-danger"></span>
                </div>
                <div class="col">
                    <label asp-for="Pages" class="form-label fw-bold"></label>
                    <input asp-for="Pages" class="form-control" placeholder="0" />
                    <span asp-validation-for="Pages" class="text-danger"></span>
                </div>
            </div>

            @* probanding si quiero que se quede aqui *@
            <div class="mb-3">
                <label asp-for="Status" class="form-label fw-bold">Reading Status</label>
                <select asp-for="Status" class="form-select"
                        asp-items="Html.GetEnumSelectList<Book_manager.Models.ReadingStatus>()">
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PublicationYear" class="form-label fw-bold"></label>
                <input asp-for="PublicationYear" class="form-control" type="number" min="1000" max="2026" placeholder="Ej: 2020" />
                <span asp-validation-for="PublicationYear" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Summary" class="form-label fw-bold"></label>
                <textarea asp-for="Summary" class="form-control" rows="3" placeholder="Brief summary..."></textarea>
                <span asp-validation-for="Summary" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CoverImageUrl" class="form-label fw-bold"></label>
                <input asp-for="CoverImageUrl" class="form-control" placeholder="https://..." />
                <span asp-validation-for="CoverImageUrl" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col">
                    <label asp-for="Rating" class="form-label fw-bold">Rating (1-5)</label>
                    <input asp-for="Rating" class="form-control" type="number" min="1" max="5" />
                    <span asp-validation-for="Rating" class="text-danger"></span>
                </div>
                <div class="col">
                    <label asp-for="Progress" class="form-label fw-bold">Pages Read</label>
                    <input asp-for="Progress" class="form-control" type="number" min="0" />
                    <span asp-validation-for="Progress" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col">
                    <label asp-for="StartedDate" class="form-label fw-bold"></label>
                    <input asp-for="StartedDate" class="form-control" />
                    <span asp-validation-for="StartedDate" class="text-danger"></span>
                </div>
                <div class="col">
                    <label asp-for="FinishedDate" class="form-label fw-bold"></label>
                    <input asp-for="FinishedDate" class="form-control" />
                    <span asp-validation-for="FinishedDate" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="RatingDescription" class="form-label fw-bold"></label>
                <textarea asp-for="RatingDescription" class="form-control" rows="2" placeholder="Your thoughts..."></textarea>
                <span asp-validation-for="RatingDescription" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <input type="submit" value="Add Book" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
